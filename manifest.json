{
  "manifest_version": 3,
  "name": "Ccfolia Helper",
  "version": "1.7.0",
  "description": "Ccfolia 마커/스크린 패널 생성 도우미",
  "permissions": [
    "clipboardRead",
    "storage",
    "tabs",
    "sidePanel"
  ],
  "side_panel": {
    "default_path": "popup.html"
  },
  "host_permissions": [
    "https://ccfolia.com/rooms/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "https://ccfolia.com/rooms/*"
      ],
      "js": [
        "inject.js"
      ],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": [
        "https://ccfolia.com/rooms/*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "Ccfolia Helper"
  }
}